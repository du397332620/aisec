{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisec.dev/schemas/fix-contract-1.0.0.json",
  "title": "AIsec FixContract 1.0.0",
  "type": "object",
  "required": ["schemaVersion", "contractId", "scanId", "findingFingerprint", "title", "evidence", "objective", "constraints", "requiredTests", "rescan", "agentPrompt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contractId": { "type": "string", "pattern": "^fix_" },
    "scanId": { "type": "string", "pattern": "^scan_" },
    "findingFingerprint": { "type": "string" },
    "title": { "type": "string" },
    "evidence": { "type": "array", "minItems": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "requiredTests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rescan": { "type": "object" },
    "agentPrompt": { "type": "string", "minLength": 1 }
  }
}
