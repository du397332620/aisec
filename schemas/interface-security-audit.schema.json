{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisec.dev/schemas/interface-security-audit-1.0.0.json",
  "title": "AIsec InterfaceSecurityAudit 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "auditId", "generatedAt", "status", "scan", "coverage",
    "coverageScope", "networkRequests", "dnsLookups",
    "credentialEnvironmentReads", "targetCodeExecutions", "summary", "entries",
    "limitations", "disclaimer"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "auditId": { "type": "string", "pattern": "^interface_audit_[0-9a-f]{16}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "review_required" },
    "scan": { "$ref": "#/$defs/scan" },
    "coverage": { "enum": ["complete", "partial"] },
    "coverageScope": { "const": "observed_attributed_routes_only" },
    "networkRequests": { "const": 0 },
    "dnsLookups": { "const": 0 },
    "credentialEnvironmentReads": { "const": 0 },
    "targetCodeExecutions": { "const": 0 },
    "summary": { "$ref": "#/$defs/summary" },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/entry" }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "disclaimer": { "type": "string", "minLength": 1, "maxLength": 1000 }
  },
  "$defs": {
    "nonNegative": { "type": "integer", "minimum": 0 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "category": {
      "enum": [
        "authentication", "object_authorization", "privileged_authorization",
        "sql_injection", "ssrf", "untrusted_file_path", "credential_forwarding",
        "exception_disclosure"
      ]
    },
    "framework": { "enum": ["FastAPI", "Express", "NestJS"] },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scanId", "projectId", "digestSha256"],
      "properties": {
        "schemaVersion": { "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0"] },
        "scanId": { "type": "string", "pattern": "^scan_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "projectId": { "type": "string", "pattern": "^project_[0-9a-f]{16}$" },
        "digestSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "sourceOmissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeAliases", "associations"],
      "properties": {
        "routeAliases": { "$ref": "#/$defs/nonNegative" },
        "associations": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "categorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "entries", "openEntries"],
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "entries": { "type": "integer", "minimum": 1 },
        "openEntries": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "attributionReason": {
      "enum": [
        "commented_out_call", "ambiguous_or_dynamic_dispatch",
        "request_origin_not_proven", "no_proven_route_path", "not_recorded"
      ]
    },
    "attributionReasonSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "signals"],
      "properties": {
        "reason": { "$ref": "#/$defs/attributionReason" },
        "signals": { "type": "integer", "minimum": 1 }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibleSignals", "attributedSignals", "unattributedSignals",
        "unattributedFindings", "reasons"
      ],
      "properties": {
        "eligibleSignals": { "$ref": "#/$defs/nonNegative" },
        "attributedSignals": { "$ref": "#/$defs/nonNegative" },
        "unattributedSignals": { "$ref": "#/$defs/nonNegative" },
        "unattributedFindings": { "$ref": "#/$defs/nonNegative" },
        "reasons": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/attributionReasonSummary" }
        }
      }
    },
    "deploymentContexts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "open"],
      "properties": {
        "observed": { "$ref": "#/$defs/nonNegative" },
        "open": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedRoutes", "routeCategoryEntries", "openEntries",
        "suppressedOnlyEntries", "emittedEntries", "omittedEntries",
        "omittedSourceRecords", "omittedFindingIdReferences",
        "unlocatedSourceRecords", "sourceOmissions", "categories",
        "attribution", "deploymentContexts"
      ],
      "properties": {
        "reviewedRoutes": { "$ref": "#/$defs/nonNegative" },
        "routeCategoryEntries": { "$ref": "#/$defs/nonNegative" },
        "openEntries": { "$ref": "#/$defs/nonNegative" },
        "suppressedOnlyEntries": { "$ref": "#/$defs/nonNegative" },
        "emittedEntries": { "$ref": "#/$defs/nonNegative" },
        "omittedEntries": { "$ref": "#/$defs/nonNegative" },
        "omittedSourceRecords": { "$ref": "#/$defs/nonNegative" },
        "omittedFindingIdReferences": { "$ref": "#/$defs/nonNegative" },
        "unlocatedSourceRecords": { "$ref": "#/$defs/nonNegative" },
        "sourceOmissions": { "$ref": "#/$defs/sourceOmissions" },
        "categories": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/categorySummary" }
        },
        "attribution": { "$ref": "#/$defs/attribution" },
        "deploymentContexts": { "$ref": "#/$defs/deploymentContexts" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "findingIds": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^finding_[0-9a-f]{16}$" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signalId", "ruleId", "fingerprint", "evidenceLevel",
        "openFindingIds", "omittedOpenFindingIds", "suppressedFindingIds",
        "omittedSuppressedFindingIds"
      ],
      "properties": {
        "signalId": { "type": "string", "pattern": "^sig_[0-9a-f]{16}$" },
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "fingerprint": { "$ref": "#/$defs/digest" },
        "evidenceLevel": { "enum": ["verified", "static_confirmed", "inferred"] },
        "handler": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "location": { "$ref": "#/$defs/location" },
        "openFindingIds": { "$ref": "#/$defs/findingIds" },
        "omittedOpenFindingIds": { "$ref": "#/$defs/nonNegative" },
        "suppressedFindingIds": { "$ref": "#/$defs/findingIds" },
        "omittedSuppressedFindingIds": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "framework", "route", "method", "path", "category", "severity",
        "findingStatus", "sourceCount", "sources", "omittedSources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^interface_audit_entry_[0-9a-f]{16}$" },
        "framework": { "$ref": "#/$defs/framework" },
        "route": { "type": "string", "pattern": "^(?:CONNECT|DELETE|GET|HEAD|OPTIONS|PATCH|POST|PUT|TRACE|ALL) +/[^\\s\\u007f]{0,480}$", "maxLength": 512 },
        "method": { "enum": ["CONNECT", "DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT", "TRACE", "ALL"] },
        "path": { "type": "string", "pattern": "^/[^\\s\\u007f]{0,480}$", "maxLength": 481 },
        "category": { "$ref": "#/$defs/category" },
        "severity": { "$ref": "#/$defs/severity" },
        "findingStatus": { "enum": ["open", "suppressed_only"] },
        "sourceCount": { "type": "integer", "minimum": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/source" }
        },
        "omittedSources": { "$ref": "#/$defs/nonNegative" }
      }
    }
  }
}
