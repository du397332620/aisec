{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisec.dev/schemas/bola-authorization-manifest-1.0.0.json",
  "title": "AIsec BOLA Authorization Manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetBaseUrl", "environment", "ownedBy", "allowedHosts", "dataPrefix", "maxRequests", "accounts", "login", "cases", "acknowledgment"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "targetBaseUrl": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 },
    "environment": { "enum": ["local", "test", "staging"] },
    "ownedBy": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "allowedHosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "const": "::1" },
          { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*$" }
        ]
      }
    },
    "dataPrefix": { "type": "string", "pattern": "^aisec[-_][A-Za-z0-9_-]{3,40}$" },
    "maxRequests": { "type": "integer", "minimum": 4, "maximum": 20 },
    "accounts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/account" }
    },
    "login": { "$ref": "#/$defs/login" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/case" }
    },
    "acknowledgment": { "const": "I am authorized to test this non-production target with two low-privilege accounts and pre-created test data" }
  },
  "$defs": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "usernameEnv", "passwordEnv"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
        "usernameEnv": { "type": "string", "pattern": "^AISEC_BOLA_[A-Z0-9_]{1,100}$" },
        "passwordEnv": { "type": "string", "pattern": "^AISEC_BOLA_[A-Z0-9_]{1,100}$" }
      }
    },
    "login": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "usernameField", "passwordField", "successStatusCodes", "tokenJsonPath", "identityJsonPath", "tokenPrefix"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "usernameField": { "$ref": "#/$defs/propertyName" },
        "passwordField": { "$ref": "#/$defs/propertyName" },
        "successStatusCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 200, "maximum": 299 }
        },
        "tokenJsonPath": { "$ref": "#/$defs/jsonPath" },
        "identityJsonPath": { "$ref": "#/$defs/jsonPath" },
        "tokenPrefix": { "const": "Bearer" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "readOnly", "testDataLabel", "ownerAccount", "otherAccount", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "method": { "enum": ["GET", "POST"] },
        "path": { "$ref": "#/$defs/path" },
        "readOnly": { "const": true },
        "testDataLabel": { "type": "string", "pattern": "^aisec[-_][A-Za-z0-9_-]{3,80}$" },
        "ownerAccount": { "type": "string", "minLength": 1, "maxLength": 100 },
        "otherAccount": { "type": "string", "minLength": 1, "maxLength": 100 },
        "body": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statusCodes", "jsonPath", "value"],
          "properties": {
            "statusCodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 200, "maximum": 299 }
            },
            "jsonPath": { "$ref": "#/$defs/jsonPath" },
            "value": { "type": "string", "pattern": "^aisec[-_][A-Za-z0-9_-]{3,80}$" }
          }
        }
      }
    },
    "path": { "type": "string", "minLength": 2, "maxLength": 2048, "pattern": "^/[^/]" },
    "propertyName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
    "jsonPath": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*){0,7}$" },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 4096 },
        { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "maxProperties": 100, "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  }
}
