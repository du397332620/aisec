{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisec.dev/schemas/rule-catalog-1.0.0.json",
  "title": "AIsec Rule Catalog 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "description", "applicabilityProfiles", "rules"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
    "applicabilityProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/applicabilityProfile" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
    "shortNonBlank": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "versionRange", "basis"],
      "properties": {
        "name": { "$ref": "#/$defs/shortNonBlank" },
        "versionRange": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
        "basis": { "enum": ["syntax", "configuration", "artifact", "engine"] }
      }
    },
    "applicabilityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "languages", "technologies", "versionStatement"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/shortNonBlank" }
        },
        "technologies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/technology" }
        },
        "versionStatement": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "source", "category", "summary", "cwe", "defaultEvidenceLevel", "applicability", "falsePositiveModes", "reviewGuidance"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 160 },
        "source": { "enum": ["native", "bundled_opengrep"] },
        "category": { "enum": ["secrets", "dataflow", "application", "api-security", "baas", "mobile-source", "mobile-artifact", "sast-general"] },
        "summary": { "$ref": "#/$defs/shortNonBlank" },
        "cwe": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^CWE-[1-9][0-9]{0,5}$" }
        },
        "defaultEvidenceLevel": { "enum": ["verified", "static_confirmed", "inferred"] },
        "applicability": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100 }
        },
        "falsePositiveModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "reviewGuidance": { "$ref": "#/$defs/nonBlank" }
      }
    }
  }
}
