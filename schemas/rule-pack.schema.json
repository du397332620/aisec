{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisec.dev/schemas/rule-pack-1.1.0.json",
  "title": "AIsec RulePack 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "description", "rules"],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0"] },
    "packId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "description": { "$ref": "#/$defs/longText" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.0.0" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "match": {
                  "type": "object",
                  "properties": { "emitWhen": false }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "literalList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[\\u0020-\\u007e]+$"
      }
    },
    "optionalLiteralList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[\\u0020-\\u007e]+$"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions"],
      "properties": {
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9][a-z0-9+_-]{0,15}$"
          }
        },
        "pathPrefixes": { "$ref": "#/$defs/stringList" },
        "pathSuffixes": { "$ref": "#/$defs/stringList" },
        "excludePathPrefixes": { "$ref": "#/$defs/stringList" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsAny"],
      "properties": {
        "containsAny": { "$ref": "#/$defs/literalList" },
        "containsAll": { "$ref": "#/$defs/optionalLiteralList" },
        "excludes": { "$ref": "#/$defs/optionalLiteralList" },
        "caseSensitive": { "type": "boolean" },
        "emitWhen": { "enum": ["present", "absent"] }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "title",
        "description",
        "severity",
        "evidenceLevel",
        "confidence",
        "cwe",
        "tags",
        "remediation",
        "files",
        "match"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^custom\\.[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "title": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/longText" },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "evidenceLevel": { "enum": ["static_confirmed", "inferred"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "cwe": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^CWE-[1-9][0-9]{0,5}$" }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        },
        "remediation": { "$ref": "#/$defs/longText" },
        "files": { "$ref": "#/$defs/files" },
        "match": { "$ref": "#/$defs/match" }
      }
    }
  }
}
