{
  "name": "@aisec/cli",
  "version": "0.1.0",
  "description": "Local-first security acceptance scanner for AI-built web and mobile projects",
  "type": "module",
  "bin": {
    "aisec": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "rules",
    "schemas",
    "benchmark",
    "examples",
    "test/fixtures",
    "README.md",
    "RULES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod 755 dist/src/cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:engines": "npm run build && node --test dist/test/engines.integration.js",
    "test:docs": "npm run build && node scripts/docs-smoke.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "test:release": "npm run build && node scripts/release-smoke.mjs",
    "rules:render": "npm run build && node scripts/rule-catalog.mjs --write",
    "rules:check": "npm run build && node scripts/rule-catalog.mjs --check",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/cli.js",
    "local-gate": "npm run build && node dist/src/cli.js local-gate",
    "benchmark": "npm run build && node dist/src/benchmark.js",
    "benchmark:resources": "npm run build && node scripts/resource-benchmark.mjs",
    "calibrate:baas": "npm run build && node scripts/baas-calibration.mjs",
    "calibrate:node-api": "npm run build && node scripts/node-api-calibration.mjs",
    "calibrate:mobile-artifacts": "npm run build && node scripts/mobile-artifact-calibration.mjs",
    "release:build": "npm run build && node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "prepublishOnly": "npm test && npm run benchmark && npm run benchmark:resources && npm run test:docs && npm run test:package && npm run test:release"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./rules/catalog.json": "./rules/catalog.json"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/du397332620/aisec.git"
  },
  "homepage": "https://github.com/du397332620/aisec#readme",
  "bugs": {
    "url": "https://github.com/du397332620/aisec/issues"
  },
  "keywords": [
    "security",
    "sast",
    "ai-generated-code",
    "mcp",
    "supabase",
    "firebase",
    "react-native",
    "flutter"
  ]
}
